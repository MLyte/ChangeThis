# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
CHANGETHIS_DATA_DIR=.changethis-data
CHANGETHIS_SECRET_KEY=
CHANGETHIS_CRON_SECRET=
AUTH_MODE=local
DATA_STORE=file
# Signup: absent ou true ouvre les inscriptions; false les met en pause.
ENABLE_PUBLIC_SIGNUP=false

# Désactive l'injection du widget ChangeThis dans l'application web locale.
ENABLE_CHANGETHIS_WIDGET=false

# ChangeThis local demo project key
NEXT_PUBLIC_DEMO_PROJECT_KEY=demo_project_key
NEXT_PUBLIC_CHANGETHIS_PROJECT_KEY=changethis_project_key
NEXT_PUBLIC_ANDENNE_BEARS_PROJECT_KEY=andenne_bears_project_key
NEXT_PUBLIC_OPTIMASTER_PROJECT_KEY=optimaster_project_key
NEXT_PUBLIC_YODA_CARROSSERIE_PROJECT_KEY=yoda_carrosserie_project_key

# Internal Ubuntu/FastAPI path
INTERNAL_API_URL=

# Optional browser-rendered screenshot enrichment.
# Requires Playwright browsers on the server: npx playwright install chromium
ENABLE_BROWSER_CAPTURE=false
BROWSER_CAPTURE_TIMEOUT_MS=12000

# Issue providers
GITHUB_TOKEN=
CHANGETHIS_GITHUB_TOKEN=
GITHUB_PROVIDER_INTEGRATION_ID=
GITHUB_APP_SLUG=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=
GITLAB_TOKEN=
CHANGETHIS_GITLAB_TOKEN=
GITLAB_PROVIDER_INTEGRATION_ID=
GITLAB_BASE_URL=https://gitlab.com
GITLAB_OAUTH_APP_ID=
GITLAB_OAUTH_APP_SECRET=
GITLAB_WEBHOOK_SECRET=
