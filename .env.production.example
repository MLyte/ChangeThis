# ChangeThis CRAW production environment example
# No secrets: replace every value marked as required before deploying.

PUBLIC_APP_URL=https://app.example.internal
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
ALLOWED_HOSTS=app.example.internal,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://app.example.internal
CORS_ALLOWED_ORIGINS=
DATABASE_URL=postgresql://changethis:PASSWORD@postgres:5432/changethis
FILES_ROOT=/var/lib/changethis/files
TEMP_DIR=/var/lib/changethis/tmp

# Optional provider integrations. Leave blank when Git issue creation is disabled.
GITHUB_TOKEN=
GITLAB_BASE_URL=
GITLAB_TOKEN=
