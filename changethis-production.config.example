# ChangeThis CRAW production setup checklist.
# Copy the relevant values into the real deployment environment.
# This file is safe to commit: it contains no secrets.

# App public URL.
# PUBLIC_APP_URL=https://app.example.internal

# Django runtime.
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=false
# ALLOWED_HOSTS=app.example.internal
# CSRF_TRUSTED_ORIGINS=https://app.example.internal
# CORS_ALLOWED_ORIGINS=

# PostgreSQL/PostGIS.
# DATABASE_URL=postgresql://changethis:PASSWORD@postgres:5432/changethis

# Server filesystem or mounted NAS paths.
# FILES_ROOT=/var/lib/changethis/files
# TEMP_DIR=/var/lib/changethis/tmp

# Optional Git provider tokens.
# GITHUB_TOKEN=
# GITLAB_BASE_URL=https://gitlab.com
# GITLAB_TOKEN=

# Smoke test after deployment.
# 1. GET /api/health
# 2. GET /api/ready
# 3. Sign up, create a site, install /widget.js on an allowed origin.
# 4. Submit widget feedback and verify it appears in /projects.
